10 REM MATRIXR6 - BASIC PORT OF Z80 MATRIX RAIN
20 REM MODEL III / LDOS / LOWERCASE + SPECIALS
30 REM BLANK RAIN ONE SECOND, NO SCREEN CLEAR
40 REM NO GLYPHS 191,46,58,59
50 DEFINT A-Z:RANDOM:CLS
60 DIM H(63),L(63),S(63),T(63)
70 FOR X=0 TO 63
80 H(X)=RND(32)-15:L(X)=6+RND(16)
90 S(X)=RND(4):T(X)=S(X)
100 NEXT X
110 IF INKEY$<>"" THEN 110
120 B=0:DU=150+RND(151):GOSUB 9000:ST=N
130 IF INKEY$<>"" THEN 990
140 FOR X=0 TO 63
150 T(X)=T(X)-1:IF T(X)>0 THEN 360
160 T(X)=S(X):Y=H(X)
170 IF Y<0 THEN 300
180 V=Y-1:IF V>=0 AND V<16 THEN GOSUB 600
190 V=Y-2:IF V>=0 AND V<16 THEN GOSUB 600
200 V=Y-3:IF V>=0 AND V<16 THEN GOSUB 600
210 V=Y:IF V>=0 AND V<16 THEN GOSUB 700
220 V=Y-4:IF V>=0 AND V<16 THEN GOSUB 750
230 V=Y-7:IF V>=0 AND V<16 THEN GOSUB 780
240 V=Y-L(X):IF V>=0 AND V<16 THEN C=32:GOSUB 850
300 H(X)=Y+1
310 IF H(X)<=15+L(X) THEN 360
320 H(X)=RND(32)-15:L(X)=6+RND(16)
330 S(X)=RND(4):T(X)=S(X)
360 NEXT X
370 GOSUB 9000
380 DT=N-ST:IF DT<0 THEN DT=DT+1800
390 IF DT<DU THEN 130
400 B=1-B:ST=N
410 IF B=1 THEN DU=30:GOTO 130
420 DU=150+RND(151):GOTO 130
600 REM MIX SPECIALS, LOWERCASE, NUMBERS
610 R=RND(32)
620 IF R<=24 THEN C=191+RND(64):GOTO 690
630 IF R<=28 THEN C=96+RND(26):GOTO 690
640 IF R<=30 THEN C=47+RND(10):GOTO 690
650 IF R=31 THEN C=64+RND(26):GOTO 690
660 C=128+RND(2)-1+4*(RND(2)-1)+16*(RND(2)-1)
690 GOSUB 850:RETURN
700 REM LEADING SPECIAL GLYPH, 192 TO 255
710 C=191+RND(64)
720 GOSUB 850:RETURN
750 REM FIRST FADE: AN OCCASIONAL GAP
760 IF RND(4)=1 THEN C=32:GOSUB 850:RETURN
770 GOSUB 600:RETURN
780 REM SECOND FADE: HALF ARE GAPS
790 IF RND(2)=1 THEN C=32:GOSUB 850:RETURN
800 GOSUB 600:RETURN
850 REM IN BLANK MODE REPLACE ONLY THIS CELL
860 IF B=1 THEN C=32
870 POKE 15360+64*V+X,C:RETURN
990 CLS:END
9000 REM READ MODEL III SECONDS + 30HZ TICKS
9010 SS=PEEK(16919):KK=PEEK(16918)
9020 IF SS<>PEEK(16919) THEN 9010
9030 N=30*SS+30-KK:RETURN
