10 REM MATRIXF2 - MATRIX RAIN IN BASIC
20 REM TRS-80 MODEL III - 64 X 16 SCREEN
30 REM NO BLOCK 191 OR ASCII 46 58 59
40 DEFINT A-Z
50 RANDOM
60 CLS
70 DIM H(63),L(63)
80 FOR X=0 TO 63
90 H(X)=-RND(16)
100 L(X)=8+RND(8)
110 NEXT X
120 IF INKEY$<>"" THEN 900
130 FOR X=0 TO 63
140 IF RND(4)<>1 THEN 350
150 Y=H(X)
160 IF Y<0 THEN 310
170 V=Y-1
180 IF V>=0 AND V<16 THEN GOSUB 500
190 V=Y-2
200 IF V>=0 AND V<16 THEN GOSUB 500
210 V=Y-3
220 IF V>=0 AND V<16 THEN GOSUB 500
230 IF Y<16 THEN POKE 15360+64*Y+X,217
240 V=Y-4
250 IF V>=0 AND V<16 THEN POKE 15360+64*V+X,202
260 V=Y-7
270 IF V>=0 AND V<16 THEN POKE 15360+64*V+X,248
280 V=Y-L(X)
290 IF V>=0 AND V<16 THEN POKE 15360+64*V+X,32
310 H(X)=Y+1
320 IF H(X)<=15+L(X) THEN 350
330 H(X)=-RND(16)
340 L(X)=8+RND(8)
350 NEXT X
360 GOTO 120
500 REM RANDOM DISPLAY CHARACTER - NO . : ;
510 R=RND(256)
520 IF R<=128 THEN C=191+RND(64):GOTO 590
530 IF R<=192 THEN C=96+RND(26):GOTO 590
540 IF R<=224 THEN C=64+RND(26):GOTO 590
550 IF R<=240 THEN C=63+RND(32):GOTO 590
560 IF R<=248 THEN C=126+2*RND(32):GOTO 590
570 C=RND(32)-1
590 POKE 15360+64*V+X,C
600 RETURN
900 CLS
910 END
