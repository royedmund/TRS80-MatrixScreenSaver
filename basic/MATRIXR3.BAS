10 REM MATRIXR3 - MATRIX RAIN - TRS-80 MODEL III
20 REM 64 X 16 LOWERCASE / SPECIAL CHARACTERS
30 REM NO FULL BLOCK OR DOT COLON SEMICOLON
40 DEFINT A-Z:RANDOM:CLS
50 DIM H(63),L(63),S(63),T(63)
60 FOR X=0 TO 63
70 H(X)=RND(32)-15:L(X)=6+RND(16)
80 S(X)=RND(4):T(X)=S(X)
90 NEXT X
100 IF INKEY$<>"" THEN 100
110 IF INKEY$<>"" THEN 900
120 FOR X=0 TO 63
130 T(X)=T(X)-1:IF T(X)>0 THEN 340
140 T(X)=S(X):Y=H(X)
150 IF Y<0 THEN 280
160 V=Y-1:IF V>=0 AND V<16 THEN GOSUB 500
170 V=Y-2:IF V>=0 AND V<16 THEN GOSUB 500
180 V=Y-3:IF V>=0 AND V<16 THEN GOSUB 500
190 V=Y:IF V<16 THEN GOSUB 600
200 V=Y-4:IF V>=0 AND V<16 THEN GOSUB 650
210 V=Y-7:IF V>=0 AND V<16 THEN GOSUB 680
220 V=Y-L(X)
230 IF V>=0 AND V<16 THEN C=32:GOSUB 750
280 H(X)=Y+1
290 IF H(X)<=15+L(X) THEN 340
300 H(X)=RND(32)-15:L(X)=6+RND(16)
310 S(X)=RND(4):T(X)=S(X)
340 NEXT X
350 GOTO 110
500 REM CHOOSE 75 PERCENT SPECIAL SYMBOLS
510 R=RND(16)
520 IF R<=12 THEN GOSUB 600:RETURN
530 IF R<=14 THEN C=96+RND(26):GOTO 590
540 IF R=15 THEN C=47+RND(10):GOTO 590
550 C=64+RND(26)
590 GOSUB 750:RETURN
600 REM SPECIAL CHARACTER FROM C0-FF HEX
610 C=191+RND(64)
620 GOSUB 750:RETURN
650 REM OCCASIONAL GAP INSIDE STREAM
660 IF RND(4)=1 THEN C=32:GOSUB 750:RETURN
670 GOSUB 500:RETURN
680 REM SPARSE FADING TRAIL
690 IF RND(2)=1 THEN C=32:GOSUB 750:RETURN
700 GOSUB 500:RETURN
750 POKE 15360+64*V+X,C:RETURN
900 CLS:END
