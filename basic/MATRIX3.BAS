10 REM MATRIX RAIN - TRS-80 MODEL III
20 REM 64 COLUMNS X 16 ROWS / ANY KEY TO EXIT
30 DEFINT A-Z:RANDOM:CLS
40 DIM H(63),L(63)
50 FOR X=0 TO 63
60 H(X)=1-RND(16):L(X)=8+RND(8)
70 NEXT X
80 FOR X=0 TO 63
90 IF RND(3)<>1 THEN 180
100 Y=H(X)
110 IF Y>0 AND Y<=16 THEN POKE 15360+64*(Y-1)+X,64+RND(26)
120 IF Y>=0 AND Y<16 THEN POKE 15360+64*Y+X,191
125 F=Y-4:IF F>=0 AND F<16 THEN POKE 15360+64*F+X,58
127 F=Y-7:IF F>=0 AND F<16 THEN POKE 15360+64*F+X,46
130 T=Y-L(X)
140 IF T>=0 AND T<16 THEN POKE 15360+64*T+X,32
150 H(X)=Y+1
160 IF H(X)>16+L(X) THEN H(X)=1-RND(16):L(X)=8+RND(8)
180 NEXT X
190 IF INKEY$="" THEN 80
200 CLS:END
